#!/usr/bin/env bash
# pib-skills — install / status / apply the Partners in Biz system skills pack
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACK_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$PACK_ROOT/manifest.json"

die() { echo "error: $*" >&2; exit 1; }

require_node() {
  command -v node >/dev/null 2>&1 || die "node is required"
}

pack_version() {
  node -e "console.log(require('$MANIFEST').packVersion)"
}

cmd_status() {
  require_node
  local ver
  ver="$(pack_version)"
  echo "pack: pib-system-skills@$ver"
  echo "root: $PACK_ROOT"
  echo "skills:"
  node -e "
    const m=require('$MANIFEST');
    for (const [tier, meta] of Object.entries(m.tiers)) {
      console.log('  ['+tier+'] '+meta.skills.length+' skills');
      for (const s of meta.skills) console.log('   - '+s);
    }
  "
  if [ -n "${PIB_SYSTEM_SKILLS_VERSION:-}" ]; then
    echo "env pin: PIB_SYSTEM_SKILLS_VERSION=$PIB_SYSTEM_SKILLS_VERSION"
  fi
}

cmd_install() {
  require_node
  # Hermes is the default runtime home. Override with PIB_SKILLS_DEST only for
  # explicit Claude/compat bridges.
  local dest="${PIB_SKILLS_DEST:-$HOME/.hermes/skills}"
  local tier="${1:-all}"
  mkdir -p "$dest"

  local skills
  skills="$(node -e "
    const m=require('$MANIFEST');
    const tier='$tier';
    let list=[];
    if (tier==='all') list=[...m.tiers.core.skills, ...m.tiers.growth.skills];
    else if (m.tiers[tier]) list=m.tiers[tier].skills;
    else { console.error('unknown tier '+tier); process.exit(1); }
    console.log(list.join('\n'));
  ")"

  while IFS= read -r skill; do
    [ -z "$skill" ] && continue
    local src="$PACK_ROOT/skills/$skill"
    local target="$dest/$skill"
    [ -d "$src" ] || { echo "skip $skill — missing at $src"; continue; }
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      rm -f "$target"
      ln -s "$src" "$target"
      echo "linked $skill -> $src"
    else
      echo "skip $skill — non-symlink exists at $target"
    fi
  done <<< "$skills"

  # Also expose under partnersinbiz/ namespace for discoverability
  mkdir -p "$dest/partnersinbiz"
  while IFS= read -r skill; do
    [ -z "$skill" ] && continue
    local src="$PACK_ROOT/skills/$skill"
    local target="$dest/partnersinbiz/$skill"
    [ -d "$src" ] || continue
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      rm -f "$target"
      ln -s "$src" "$target"
    fi
  done <<< "$skills"

  echo
  echo "Installed pib-system-skills@$(pack_version) into $dest"
}

cmd_verify_contracts() {
  require_node
  node "$PACK_ROOT/bin/verify-contracts.mjs"
}

cmd_help() {
  cat <<EOF
pib-skills — Partners in Biz system skills pack

Usage:
  pib-skills status
  pib-skills install [all|core|growth]
  pib-skills verify-contracts

Env:
  PIB_SKILLS_DEST              install target (default: ~/.hermes/skills)
  PIB_SYSTEM_SKILLS_VERSION    optional pin for consumers
EOF
}

main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    install) cmd_install "$@" ;;
    verify-contracts) cmd_verify_contracts "$@" ;;
    -h|--help|help) cmd_help ;;
    *) die "unknown command: $cmd (try help)" ;;
  esac
}

main "$@"
