[Unit]
Description=Partners in Biz linked VPS runtime
Documentation=https://partnersinbiz.online
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/partnersinbiz/current/pib-runtime supervise
Restart=always
RestartSec=5s
# A linked Hermes run can remain active for much longer than a normal process
# shutdown. SIGTERM stops new claims and lets the current run drain; never
# force-kill it during a routine runtime update.
TimeoutStopSec=2h
StateDirectory=partnersinbiz
StateDirectoryMode=0700
LogsDirectory=partnersinbiz
LogsDirectoryMode=0700
UMask=0077
Environment=PIB_RUNTIME_STATE_DIR=/var/lib/partnersinbiz
Environment=PIB_CREDENTIAL_HELPER=/opt/partnersinbiz/current/pib-credential-helper
Environment=PIB_FILE_HELPER=/opt/partnersinbiz/current/pib-file-helper
Environment=PIB_API_BASE=https://partnersinbiz.online
Environment=PIB_SYNC_PROTOCOL_VERSION=1
EnvironmentFile=-/etc/partnersinbiz/runtime.env
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
