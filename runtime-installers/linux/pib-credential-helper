#!/bin/bash
set -euo pipefail

umask 077
STORE="${PIB_CREDENTIAL_DIR:-/var/lib/partnersinbiz/credentials}"
PYTHON="${PIB_PYTHON3:-python3}"
CREDENTIAL_NAME_PREFIX="partnersinbiz.runtime."

fail() { echo "$1" >&2; exit "${2:-1}"; }
require_root() {
  [[ $EUID -eq 0 || "${PIB_CREDENTIAL_HELPER_TESTING:-0}" == 1 ]] || fail 'The Linux credential helper must run as root.'
}
validate_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail 'Invalid credential name.' 2
}
assert_store() {
  [[ ! -L "$STORE" ]] || fail 'Credential store symlink refused.'
  install -d -m 0700 "$STORE"
  chmod 0700 "$STORE"
  "$PYTHON" - "$STORE" "${PIB_CREDENTIAL_HELPER_TESTING:-0}" <<'PY'
import os, stat, sys
path, testing = sys.argv[1], sys.argv[2] == "1"
value = os.lstat(path)
if not stat.S_ISDIR(value.st_mode) or stat.S_IMODE(value.st_mode) != 0o700:
    raise SystemExit("credential store permissions invalid")
if not testing and value.st_uid != 0:
    raise SystemExit("credential store owner invalid")
PY
}
assert_ciphertext() {
  local file="$1"
  [[ -f "$file" && ! -L "$file" ]] || fail 'Encrypted credential is missing or unsafe.'
  "$PYTHON" - "$file" "${PIB_CREDENTIAL_HELPER_TESTING:-0}" <<'PY'
import os, stat, sys
path, testing = sys.argv[1], sys.argv[2] == "1"
value = os.lstat(path)
if not stat.S_ISREG(value.st_mode) or stat.S_IMODE(value.st_mode) != 0o600:
    raise SystemExit("encrypted credential permissions invalid")
if not testing and value.st_uid != 0:
    raise SystemExit("encrypted credential owner invalid")
PY
}
fsync_path() {
  "$PYTHON" - "$1" <<'PY'
import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY
}

require_root
command -v systemd-creds >/dev/null || fail 'systemd-creds is required (systemd 250 or newer).'
command -v "$PYTHON" >/dev/null || fail 'Python 3 is required.'

case "${1:-}" in
  put)
    validate_name "${2:-}"
    assert_store
    name="$2"; file="$STORE/$name.cred"; temp="$(mktemp "$STORE/.$name.XXXXXX")"
    cleanup() { rm -f -- "$temp"; }
    trap cleanup EXIT HUP INT TERM
    systemd-creds encrypt --no-ask-password --with-key=host --name="$CREDENTIAL_NAME_PREFIX$name" - "$temp"
    chmod 0600 "$temp"
    systemd-creds decrypt --no-ask-password --name="$CREDENTIAL_NAME_PREFIX$name" "$temp" - >/dev/null
    fsync_path "$temp"
    mv -f -- "$temp" "$file"
    trap - EXIT HUP INT TERM
    fsync_path "$STORE"
    ;;
  get)
    validate_name "${2:-}"
    assert_store
    name="$2"; file="$STORE/$name.cred"
    assert_ciphertext "$file"
    exec systemd-creds decrypt --no-ask-password --name="$CREDENTIAL_NAME_PREFIX$name" "$file" -
    ;;
  clear)
    [[ $# -eq 1 ]] || fail 'usage: pib-credential-helper clear' 2
    assert_store
    shopt -s nullglob
    files=("$STORE"/*.cred)
    ((${#files[@]} == 0)) || rm -f -- "${files[@]}"
    fsync_path "$STORE"
    ;;
  *) fail 'usage: pib-credential-helper put NAME|get NAME|clear' 2 ;;
esac
