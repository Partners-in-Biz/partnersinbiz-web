{
  "name": "partnersinbiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run typecheck && NODE_OPTIONS=--max-old-space-size=6144 next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/check-quality-ratchet.mjs",
    "workspace:audit": "npx tsx scripts/audit-client-workspaces.ts",
    "workspace:pull": "npx tsx scripts/pull-client-workspace.ts",
    "workspace:sync": "npx tsx scripts/sync-client-workspace.ts",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit --pretty false --project tsconfig.typecheck.json",
    "check:email-deliverability-env": "node scripts/check-email-deliverability-env.mjs",
    "check:hermes-desktop-parity": "node scripts/check-hermes-desktop-parity.mjs",
    "proof:creative-canvas": "node scripts/creative-canvas-world-class-proof.mjs",
    "smoke:creative-canvas-fal-byok": "node scripts/creative-canvas-fal-byok-smoke.mjs",
    "okf:validate": "node scripts/okf-validate-export.mjs --json",
    "test:finance:unit": "jest --runInBand __tests__/finance/foundation-context.test.ts __tests__/finance/foundation-domain.test.ts __tests__/finance/foundation-p1-blockers.test.ts __tests__/finance/foundation-remediation.test.ts __tests__/finance/foundation-service.integration.test.ts __tests__/finance/foundation-storage-contract.test.ts __tests__/finance/tax-domain.test.ts __tests__/finance/tax-service.integration.test.ts __tests__/finance/reporting-domain.test.ts __tests__/finance/reporting-service.integration.test.ts __tests__/finance/documents-domain.test.ts __tests__/finance/documents-service.integration.test.ts __tests__/finance/intercompany-domain.test.ts __tests__/finance/intercompany-service.integration.test.ts __tests__/finance/payroll-domain.test.ts __tests__/finance/payroll-service.integration.test.ts __tests__/finance/payroll-payrun-domain.test.ts __tests__/finance/payroll-payrun-service.integration.test.ts __tests__/finance/payroll-statutory-domain.test.ts __tests__/finance/payroll-statutory-service.integration.test.ts",
    "test:finance:emulator": "firebase emulators:exec --only firestore --project finance-foundation-emulator \"jest --runInBand __tests__/finance/foundation-firestore-emulator.test.ts\"",
    "test:finance:tax-reporting": "jest --runInBand __tests__/finance/tax-domain.test.ts __tests__/finance/tax-service.integration.test.ts __tests__/finance/reporting-domain.test.ts __tests__/finance/reporting-service.integration.test.ts",
    "verify:finance:foundation": "npm run test:finance:unit && npm run test:finance:emulator && tsx scripts/finance/verify-foundation.ts",
    "verify:finance:tax-reporting": "npm run test:finance:tax-reporting && tsx scripts/finance/verify-tax-reporting.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:finance:documents": "jest --runInBand __tests__/finance/documents-domain.test.ts __tests__/finance/documents-service.integration.test.ts __tests__/finance/foundation-storage-contract.test.ts",
    "verify:finance:documents": "npm run test:finance:documents && tsx scripts/finance/verify-documents.ts",
    "test:finance:intercompany": "jest --runInBand __tests__/finance/intercompany-domain.test.ts __tests__/finance/intercompany-service.integration.test.ts __tests__/finance/foundation-storage-contract.test.ts",
    "verify:finance:intercompany": "npm run test:finance:intercompany && tsx scripts/finance/verify-intercompany.ts",
    "test:finance:payroll": "jest --runInBand __tests__/finance/payroll-domain.test.ts __tests__/finance/payroll-service.integration.test.ts __tests__/finance/payroll-payrun-domain.test.ts __tests__/finance/payroll-payrun-service.integration.test.ts __tests__/finance/payroll-statutory-domain.test.ts __tests__/finance/payroll-statutory-service.integration.test.ts __tests__/finance/foundation-storage-contract.test.ts",
    "verify:finance:payroll": "npm run test:finance:payroll && tsx scripts/finance/verify-payroll.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@partnersinbiz/analytics-js": "file:./packages/analytics-js",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@vercel/analytics": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.138",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "svix": "^1.94.0",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "firebase-tools": "^15.25.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
