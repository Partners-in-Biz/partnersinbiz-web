rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isClientFor(clientId) {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId;
    }

    function isOrgMember(orgId) {
      return request.auth != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/orgMembers/$(orgId + "_" + request.auth.uid))
      );
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      // Clients may create their own doc (role locked to "client"); admin writes via Admin SDK
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == "client";
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
      allow write: if isAdmin();
    }

    // ── Enquiries (existing) ─────────────────────────────────────────────────
    match /enquiries/{id} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // all writes via Admin SDK only
    }

    // ── CRM ──────────────────────────────────────────────────────────────────
    match /contacts/{id} {
      allow read, write: if isAdmin();
    }

    match /deals/{id} {
      allow read, write: if isAdmin();
    }

    match /activities/{id} {
      allow read, write: if isAdmin();
    }

    // ── Email ────────────────────────────────────────────────────────────────
    match /emails/{id} {
      allow read, write: if isAdmin();
    }

    // ── Sequences ────────────────────────────────────────────────────────────
    match /sequences/{id} {
      allow read, write: if isAdmin();
    }

    match /sequence_enrollments/{id} {
      allow read, write: if isAdmin();
    }

    // ── Client portal ────────────────────────────────────────────────────────
    match /clients/{id} {
      allow read: if isAdmin() || isClientFor(id);
      allow write: if isAdmin();
    }

    match /projects/{id} {
      // Project access is relationship-aware and public project responses redact
      // filesystem/runtime bindings. Keep every browser read/write behind the API.
      allow read, write: if false;
    }

    match /projects/{projectId}/tasks/{taskId} {
      // Task access follows the parent project's current organisation links.
      allow read, write: if false;
    }

    match /projects/{projectId}/tasks/{taskId}/comments/{commentId} {
      allow read, write: if false;
    }

    match /project_setup_operations/{operationId} {
      allow read, write: if false;
    }

    match /project_user_library/{linkId} {
      allow read, write: if false;
    }

    match /tasks/{id} {
      allow read: if isAdmin() || isClientFor(resource.data.clientId);
      allow write: if isAdmin();
    }

    match /tasks/{taskId}/comments/{commentId} {
      allow read: if isAdmin() || isClientFor(
        get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId
      );
      allow write: if isAdmin() || isClientFor(
        get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId
      );
    }

    match /invoices/{id} {
      allow read: if isAdmin() || isClientFor(resource.data.clientId);
      allow write: if isAdmin();
    }

    match /recurring_schedules/{id} {
      allow read, write: if isAdmin();
    }

    // ── Marketing ────────────────────────────────────────────────────────────
    match /campaigns/{id} {
      allow read, write: if isAdmin();
    }

    // ── AI audit log ─────────────────────────────────────────────────────────
    match /ai_action_log/{id} {
      allow read, write: if isAdmin();
    }

    // Agent memory chunks are retrieved only through authenticated API routes
    // using the Admin SDK. They can contain cross-source private snippets.
    match /agent_memory_chunks/{id} {
      allow read, write: if false;
    }

    // ── Organizations ────────────────────────────────────────────────────────
    // Note: members array items must have exactly {userId, role} — no extra fields —
    // for hasAny map-equality checks to work correctly.
    //
    // firebase-tools deploy emits "Invalid variable name" warnings for `userId`
    // and `role` in the hasAny([{...}]) literals below. False positive: those are
    // map keys in an object literal, not variable references. Rules evaluate
    // correctly at runtime. See firebase-tools issue tracker; safe to ignore.
    match /organizations/{orgId} {
      allow read: if isAdmin() || (request.auth != null &&
        (resource.data.members.hasAny([{ userId: request.auth.uid, role: 'owner' }]) ||
         resource.data.members.hasAny([{ userId: request.auth.uid, role: 'admin' }]) ||
         resource.data.members.hasAny([{ userId: request.auth.uid, role: 'member' }])));
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null &&
        (resource.data.members.hasAny([{ userId: request.auth.uid, role: 'owner' }]) ||
         resource.data.members.hasAny([{ userId: request.auth.uid, role: 'admin' }])));
      allow delete: if request.auth != null &&
        resource.data.members.hasAny([{ userId: request.auth.uid, role: 'owner' }]);

      match /crm_live_updates/{entity} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // New collections (2026-04-16 agent API skills build)
    //
    // Rule of thumb: writes are via Admin SDK only (deny client writes),
    // reads are admin-only unless a specific client-visible surface is
    // defined. The /api/v1 routes use `withAuth` on the server; the rules
    // below enforce defense in depth for direct Firestore access.
    // ──────────────────────────────────────────────────────────────────────────

    // Finance/accounting foundation is server-only. Every API request must pass
    // canonical org membership plus explicit legal-entity/book role checks.
    match /legal_entities/{id} { allow read, write: if false; }
    match /finance_branches/{id} { allow read, write: if false; }
    match /accounting_books/{id} { allow read, write: if false; }
    match /book_policy_versions/{id} { allow read, write: if false; }
    match /accounting_periods/{id} { allow read, write: if false; }
    match /finance_role_assignments/{id} { allow read, write: if false; }
    match /finance_approvals/{id} { allow read, write: if false; }
    match /ledger_accounts/{id} { allow read, write: if false; }
    match /journal_entries/{id} { allow read, write: if false; }
    match /journal_lines/{id} { allow read, write: if false; }
    match /finance_unique_claims/{id} { allow read, write: if false; }
    match /finance_idempotency_claims/{id} { allow read, write: if false; }
    match /finance_calendar_heads/{id} { allow read, write: if false; }
    match /finance_sequences/{id} { allow read, write: if false; }
    match /finance_audit_events/{id} { allow read, write: if false; }
    match /finance_audit_heads/{id} { allow read, write: if false; }
    match /finance_outbox_events/{id} { allow read, write: if false; }
    match /tax_codes/{id} { allow read, write: if false; }
    match /tax_rule_versions/{id} { allow read, write: if false; }
    match /tax_periods/{id} { allow read, write: if false; }
    match /tax_return_snapshots/{id} { allow read, write: if false; }
    match /tax_return_lines/{id} { allow read, write: if false; }
    match /financial_report_snapshots/{id} { allow read, write: if false; }
    match /supplier_bills/{id} { allow read, write: if false; }
    match /supplier_bill_lines/{id} { allow read, write: if false; }
    match /finance_customer_invoices/{id} { allow read, write: if false; }
    match /finance_customer_invoice_lines/{id} { allow read, write: if false; }
    match /open_items/{id} { allow read, write: if false; }
    match /account_credits/{id} { allow read, write: if false; }
    match /finance_payments/{id} { allow read, write: if false; }
    match /payment_allocations/{id} { allow read, write: if false; }
    match /bank_accounts/{id} { allow read, write: if false; }
    match /bank_transactions/{id} { allow read, write: if false; }
    match /reconciliations/{id} { allow read, write: if false; }
    match /reconciliation_matches/{id} { allow read, write: if false; }
    match /reconciliation_adjustments/{id} { allow read, write: if false; }
    match /intercompany_pairs/{id} { allow read, write: if false; }
    match /intercompany_transactions/{id} { allow read, write: if false; }
    match /elimination_rules/{id} { allow read, write: if false; }
    match /consolidation_runs/{id} { allow read, write: if false; }
    match /consolidation_entries/{id} { allow read, write: if false; }
    match /payroll_employees/{id} { allow read, write: if false; }
    match /payroll_employments/{id} { allow read, write: if false; }
    match /employment_term_versions/{id} { allow read, write: if false; }
    match /pay_components/{id} { allow read, write: if false; }
    match /payroll_rule_versions/{id} { allow read, write: if false; }
    match /payroll_calendars/{id} { allow read, write: if false; }
    match /pay_periods/{id} { allow read, write: if false; }
    match /payroll_calculations/{id} { allow read, write: if false; }
    match /payroll_tax_years/{id} { allow read, write: if false; }
    match /payroll_ytd_openings/{id} { allow read, write: if false; }
    match /payroll_calculation_manifests/{id} { allow read, write: if false; }
    match /pay_runs/{id} { allow read, write: if false; }
    match /pay_run_items/{id} { allow read, write: if false; }
    match /pay_run_item_components/{id} { allow read, write: if false; }
    match /payslips/{id} { allow read, write: if false; }
    match /payroll_adjustments/{id} { allow read, write: if false; }
    match /leave_records/{id} { allow read, write: if false; }
    match /irp5_records/{id} { allow read, write: if false; }
    match /emp201_snapshots/{id} { allow read, write: if false; }
    match /emp501_reconciliations/{id} { allow read, write: if false; }
    match /payroll_export_manifests/{id} { allow read, write: if false; }

    // Idempotency cache — never client-readable or writable.
    match /idempotency_keys/{id} {
      allow read, write: if false;
    }

    // Durable Messages action receipts contain execution evidence and are
    // exposed only through the conversation-authorised API.
    match /chat_action_receipts/{id} {
      allow read, write: if false;
    }

    // Unified comments — admin read/write. Clients cannot see each other's
    // comment threads (even on their own resources) without deliberate
    // per-resource exposure later.
    match /comments/{id} {
      allow read, write: if isAdmin();
    }

    // Standalone tasks (distinct from the nested /tasks/{taskId}/comments above).
    // Admin only; if a client needs to see their tasks we'd add an orgId check.
    match /tasks/{id} {
      allow read: if isAdmin() || (resource.data.orgId != null && isClientFor(resource.data.orgId));
      allow write: if isAdmin();
    }

    // Notifications — admin read/write. Per-user visibility via API (withAuth)
    // rather than client-side Firestore reads.
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // Push tokens — written exclusively through /api/v1/push-tokens via the
    // Admin SDK so user/org metadata can't be forged from the client.
    match /pushTokens/{id} {
      allow read, write: if false;
    }

    // File metadata — admin read/write. Uploads are via Admin SDK through /upload.
    match /uploads/{id} {
      allow read, write: if isAdmin();
    }

    // Calendar events — admin read/write.
    match /calendar_events/{id} {
      allow read, write: if isAdmin();
    }

    // Time tracking — admin read/write. Self-only reads are API-gated.
    match /time_entries/{id} {
      allow read, write: if isAdmin();
    }

    // Expenses — admin read/write.
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // Forms — admin read/write. Public submit goes through the /api/v1/forms/[slug]/submit
    // route which uses Admin SDK; no client-side form submit to Firestore.
    match /forms/{id} {
      allow read, write: if isAdmin();
    }

    match /form_submissions/{id} {
      allow read, write: if isAdmin();
    }

    // Form rate-limit buckets — never client-readable or writable.
    match /form_rate_limits/{id} {
      allow read, write: if false;
    }

    // Outbound webhooks system — admin only. Queue + deliveries are internal.
    match /outbound_webhooks/{id} {
      allow read, write: if isAdmin();
    }

    match /webhook_queue/{id} {
      allow read, write: if false;
    }

    match /webhook_deliveries/{id} {
      allow read, write: if isAdmin();
    }

    // Properties — managed via server-side API only
    match /properties/{docId} {
      allow read, write: if false;
    }

    // Analytics — all written via Admin SDK (ingest endpoint), all queried via admin-authed API
    match /product_events/{id} {
      allow read, write: if false;
    }

    match /product_sessions/{id} {
      allow read, write: if false;
    }

    match /product_funnels/{id} {
      allow read, write: if false;
    }

    // Analytics rate limiting — internal only
    match /analytics_rate_limits/{id} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // SEO Sprint Manager (2026-05-04)
    //
    // All writes via Admin SDK only. Reads are tenant-scoped via orgId on the
    // auth token claim. Audits expose an optional public-share token for
    // read-only deep links. Optimization log is admin-internal only.
    // ──────────────────────────────────────────────────────────────────────────
    match /seo_sprints/{id} {
      allow read: if request.auth != null && resource.data.orgId == request.auth.token.orgId;
      allow write: if false; // admin SDK only
    }
    match /seo_tasks/{id} {
      allow read: if request.auth != null && resource.data.orgId == request.auth.token.orgId;
      allow write: if false;
    }
    match /seo_keywords/{id} {
      allow read: if request.auth != null && resource.data.orgId == request.auth.token.orgId;
      allow write: if false;
    }
    match /seo_backlinks/{id} {
      allow read: if request.auth != null && resource.data.orgId == request.auth.token.orgId;
      allow write: if false;
    }
    match /seo_content/{id} {
      allow read: if request.auth != null && resource.data.orgId == request.auth.token.orgId;
      allow write: if false;
    }
    match /seo_audits/{id} {
      allow read: if request.auth != null
        && (resource.data.orgId == request.auth.token.orgId
            || resource.data.publicShareToken == request.query.token);
      allow write: if false;
    }
    match /seo_optimizations/{id} {
      // Admin only — clients never read optimization log
      allow read: if false;
      allow write: if false;
    }
    // All Hermes collections go through API routes (server SDK). Block direct client access.
    match /hermes_profile_links/{orgId} {
      allow read, write: if false;
    }
    match /hermes_runs/{id} {
      allow read, write: if false;
    }
    match /hermes_conversations/{convId} {
      allow read, write: if false;
      match /messages/{msgId} {
        allow read, write: if false;
      }
    }

    // ── Agent Team (2026-05-13) ───────────────────────────────────────────────
    // Any authenticated user can read agent team docs (names, personas, status).
    // Only admins can write — all production writes go through Admin SDK / API routes.
    match /agent_team/{agentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Org Chat Config (2026-05-13) ─────────────────────────────────────────
    // Admin writes only (all via Admin SDK). Any authenticated user can read
    // their org's chat config (e.g. which agents are enabled for them).
    match /org_chat_config/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Conversations + Messages (2026-05-13) ─────────────────────────────────
    // Conversations are server-mediated because their API serializers remove
    // runtime filesystem paths and their access policy depends on current org,
    // project, participant, and share-mode state. Admin SDK operations bypass
    // these rules; browser/client Firebase credentials must never read or
    // mutate the unredacted records directly.
    match /conversations/{convId} {
      allow read, write: if false;
    }
    match /conversations/{convId}/messages/{msgId} {
      allow read, write: if false;
    }
  }
}
